rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ============================================================
       FUNCIONES GENERALES
    ============================================================ */

    function estaAutenticado() {
      return request.auth != null;
    }

    function esAdmin() {
      return estaAutenticado()
        && exists(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        ).data.rol == "admin";
    }

    function esModerador() {
      return estaAutenticado()
        && exists(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        ).data.rol == "moderador";
    }

    function puedeRevisarReportes() {
      return esAdmin() || esModerador();
    }


    /* ============================================================
       USUARIOS
       
       REGLAS EXISTENTES
       NO MODIFICAR
    ============================================================ */

    match /usuarios/{userId} {

      allow get, list: if esAdmin();

      allow get: if estaAutenticado()
        && request.auth.uid == userId;

      allow create: if estaAutenticado()
        && request.auth.uid == userId;

      allow update: if esAdmin()
        && (
          userId != request.auth.uid
          || request.resource.data.rol == "admin"
        );

      allow update: if estaAutenticado()
        && request.auth.uid == userId
        && request.resource.data.rol == resource.data.rol
        && request.resource.data.activo == resource.data.activo;

      allow delete: if esAdmin();

      match /actividad/{actividadId} {
        allow read, write: if estaAutenticado()
          && request.auth.uid == userId;
      }
    }


    /* ============================================================
       NOTICIAS
       
       REGLAS EXISTENTES
       NO MODIFICAR
    ============================================================ */

    match /noticias/{noticiaId} {

      allow get, list: if
        estaAutenticado()
        &&
        (
          resource.data.estado == "publicada"
          ||
          esAdmin()
          ||
          esModerador()
        );

      allow create: if false;

      allow update: if
        estaAutenticado()
        &&
        (
          esAdmin()
          ||
          esModerador()
        );

      allow delete: if esAdmin();
    }


    /* ============================================================
       ALERTAS SANITARIAS
    ============================================================ */

    match /alertas/{alertaId} {

      allow get, list: if esAdmin();

      allow get: if estaAutenticado()
        && resource.data.estado == "activa";

      allow list: if estaAutenticado()
        && resource.data.estado == "activa";

      allow create: if esAdmin();

      allow update: if esAdmin();

      allow delete: if esAdmin();
    }


    /* ============================================================
       CENTROS MÉDICOS
    ============================================================ */

    match /centrosMedicos/{centroId} {

      allow get, list: if esAdmin();

      allow get: if estaAutenticado()
        && resource.data.estado == "activo";

      allow list: if estaAutenticado()
        && resource.data.estado == "activo";

      allow create: if esAdmin();

      allow update: if esAdmin();

      allow delete: if esAdmin();
    }


    /* ============================================================
       REPORTES
    ============================================================ */

    match /reportes/{reporteId} {

      allow create: if estaAutenticado()
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.estado == "pendiente"
        && request.resource.data.vecesReportado == 1;

      allow get: if estaAutenticado()
        && resource.data.creadoPor == request.auth.uid;

      allow list: if estaAutenticado()
        && resource.data.creadoPor == request.auth.uid;

      allow update: if estaAutenticado()
        && resource.data.creadoPor == request.auth.uid

        && request.resource.data.creadoPor
          == resource.data.creadoPor

        && request.resource.data.pagina
          == resource.data.pagina

        && request.resource.data.recursoId
          == resource.data.recursoId

        && request.resource.data.tipo
          == resource.data.tipo

        && request.resource.data.grupoClave
          == resource.data.grupoClave

        && request.resource.data.vecesReportado
          == resource.data.vecesReportado + 1

        && request.resource.data.estado
          == "pendiente"

        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "ultimaDescripcion",
            "ultimaActividad",
            "vecesReportado",
            "estado"
          ]);

      allow get, list: if puedeRevisarReportes();

      allow update: if puedeRevisarReportes();

      allow delete: if false;
    }


/* ============================================================
   TOKENS DE NOTIFICACIONES
       
   SOLO ANDROID
============================================================ */

match /notificationTokens/{userId} {

  /*
   * CREAR TOKEN
   *
   * El ID del documento debe ser el UID
   * del usuario autenticado.
   */
  allow create: if estaAutenticado()
    && userId == request.auth.uid
    && request.resource.data.uid == request.auth.uid
    && request.resource.data.platform == "android"
    && request.resource.data.enabled == true;


  /*
   * LEER TOKEN
   *
   * El usuario solamente puede leer
   * su propio documento.
   */
  allow read: if estaAutenticado()
    && userId == request.auth.uid;


  /*
   * ACTUALIZAR TOKEN
   *
   * El usuario solamente puede actualizar
   * su propio documento.
   *
   * El UID no puede cambiar.
   */
  allow update: if estaAutenticado()
    && userId == request.auth.uid
    && resource.data.uid == request.auth.uid
    && request.resource.data.uid == request.auth.uid
    && request.resource.data.platform == "android";


  /*
   * ELIMINAR TOKEN
   */
  allow delete: if estaAutenticado()
    && userId == request.auth.uid;
}

  }
}