rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ============================================================
       FUNCIONES GENERALES
    ============================================================ */

    function estaAutenticado() {
      return request.auth != null;
    }

    function esAdmin() {
      return estaAutenticado()
        && exists(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        ).data.rol == "admin";
    }

    function esModerador() {
      return estaAutenticado()
        && exists(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        ).data.rol == "moderador";
    }

    function puedeRevisarReportes() {
      return esAdmin() || esModerador();
    }


    /* ============================================================
       USUARIOS
    ============================================================ */

    match /usuarios/{userId} {

      // ADMIN Y MODERADOR pueden consultar/listar usuarios
      allow get, list: if esAdmin() || esModerador();

      // Cada usuario puede consultar su propio perfil
      allow get: if estaAutenticado()
        && request.auth.uid == userId;

      // Crear perfil propio
      allow create: if estaAutenticado()
        && request.auth.uid == userId;

      // ADMIN puede actualizar usuarios y cambiar roles
      allow update: if esAdmin()
        && (
          userId != request.auth.uid
          || request.resource.data.rol == "admin"
        );

      // MODERADOR solo puede activar/desactivar usuarios.
      // No puede cambiar rol ni otros datos.
      allow update: if esModerador()
        && userId != request.auth.uid
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "activo"
          ]);

      // Usuario puede actualizar su propio perfil,
      // pero no puede cambiar rol ni estado.
      allow update: if estaAutenticado()
        && request.auth.uid == userId
        && request.resource.data.rol == resource.data.rol
        && request.resource.data.activo == resource.data.activo;

      // ADMIN puede eliminar perfiles de otros usuarios
      allow delete: if esAdmin()
        && userId != request.auth.uid;


      /* ==========================================================
         ACTIVIDAD
      ========================================================== */

      match /actividad/{actividadId} {

        // Usuario puede leer su propia actividad.
        // Admin puede leer actividad de otros usuarios.
        allow read: if estaAutenticado()
          && (
            request.auth.uid == userId
            || esAdmin()
          );

        // Solo el propio usuario puede crear/modificar su actividad
        allow create, update: if estaAutenticado()
          && request.auth.uid == userId;

        // Usuario puede eliminar su actividad.
        // Admin puede eliminar actividad de otros usuarios.
        allow delete: if estaAutenticado()
          && (
            request.auth.uid == userId
            || (esAdmin() && userId != request.auth.uid)
          );
      }


      /* ==========================================================
         TOKENS DE NOTIFICACIONES
      ========================================================== */

      match /notificationTokens/{tokenId} {

        allow create: if estaAutenticado()
          && request.auth.uid == userId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.platform == "android";

        allow get: if estaAutenticado()
          && request.auth.uid == userId;

        allow update: if estaAutenticado()
          && request.auth.uid == userId
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.platform == "android";

        allow delete: if estaAutenticado()
          && request.auth.uid == userId;
      }
    }


    /* ============================================================
       NOTICIAS
    ============================================================ */

    match /noticias/{noticiaId} {

      // Usuarios autenticados pueden ver publicadas.
      // Admin y moderador pueden ver todas.
      allow get, list: if estaAutenticado()
        && (
          resource.data.estado == "publicada"
          || esAdmin()
          || esModerador()
        );

      // Las noticias no se crean directamente desde esta app
      allow create: if false;

      // Admin y moderador pueden actualizar noticias
      allow update: if estaAutenticado()
        && (
          esAdmin()
          || esModerador()
        );

      // Solo admin puede eliminar
      allow delete: if esAdmin();
    }


    /* ============================================================
       ALERTAS SANITARIAS
    ============================================================ */

    match /alertas/{alertaId} {

      // Admin y moderador pueden consultar todas las alertas
      allow get, list: if esAdmin() || esModerador();

      // Usuarios autenticados pueden ver alertas activas
      allow get: if estaAutenticado()
        && resource.data.estado == "activa";

      // Usuarios autenticados pueden listar alertas activas
      allow list: if estaAutenticado()
        && resource.data.estado == "activa";

      // Admin y moderador pueden crear alertas
      allow create: if esAdmin() || esModerador();

      // Admin y moderador pueden actualizar alertas
      allow update: if esAdmin() || esModerador();

      // Solo admin puede eliminar
      allow delete: if esAdmin();
    }


    /* ============================================================
       CENTROS MÉDICOS
    ============================================================ */

    match /centrosMedicos/{centroId} {

      // Solo admin puede consultar todos los centros
      allow get, list: if esAdmin();

      // Aplicación pública:
      // solo centros activos
      allow get: if estaAutenticado()
        && resource.data.estado == "activo";

      allow list: if estaAutenticado()
        && resource.data.estado == "activo";

      // Solo admin gestiona centros
      allow create: if esAdmin();

      allow update: if esAdmin();

      allow delete: if esAdmin();
    }


    /* ============================================================
       REPORTES
    ============================================================ */

    match /reportes/{reporteId} {

      /* ==========================================================
         USUARIOS AUTENTICADOS
      ========================================================== */

      // Usuario crea su propio reporte
      allow create: if estaAutenticado()
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.estado == "pendiente"
        && request.resource.data.vecesReportado == 1;

      // Usuario puede consultar sus propios reportes
      allow get, list: if estaAutenticado()
        && resource.data.creadoPor == request.auth.uid;

      // Usuario puede actualizar su propio reporte
      allow update: if estaAutenticado()
        && resource.data.creadoPor == request.auth.uid
        && request.resource.data.creadoPor == resource.data.creadoPor
        && request.resource.data.vecesReportado ==
           resource.data.vecesReportado + 1
        && request.resource.data.estado == "pendiente";


      /* ==========================================================
         ADMINISTRADORES Y MODERADORES
      ========================================================== */

      // Admin y moderador pueden revisar y gestionar reportes
      allow get, list, update, delete: if puedeRevisarReportes();
    }

  }
}